# Copy to backend/.env. Every setting is optional for local development.

# Signs login tokens. Required anywhere real people log in:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGRINEXUS_SECRET_KEY=kkkkl-knnml-kjkkk;

# Defaults to the PostgreSQL container in docker-compose.yml (host port 5433).
# If you change the user, password or port there, change them here too.
# AGRINEXUS_DATABASE_URL=postgresql+psycopg://agrinexus:agrinexus@localhost:5433/agrinexus
#
# SQLite also works for a quick run without Docker:
# AGRINEXUS_DATABASE_URL=sqlite:///./agrinexus.db

# AGRINEXUS_TOKEN_HOURS=12
# AGRINEXUS_REMEMBER_ME_DAYS=30
# AGRINEXUS_CORS_ORIGINS=["http://localhost:5173"]

# Google Cloud Translation, for every language except English. Stays on the server.
# Create an API key restricted to the "Cloud Translation API" and set a daily quota on it.
# Without it the app shows English wherever nothing is cached yet.
# AGRINEXUS_GOOGLE_TRANSLATE_API_KEY=
# AGRINEXUS_TRANSLATE_CHARS_PER_HOUR=50000
