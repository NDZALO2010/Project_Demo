{
  "name": "agrinexus-root",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:shell": "docker compose exec db psql -U agrinexus agrinexus",
    "dev:api": "node scripts/backend.mjs -m uvicorn app.main:app --reload --port 8000",
    "setup:api": "cd backend && python -m venv .venv && node ../scripts/backend.mjs -m pip install -r requirements.txt",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend run test",
    "test:watch": "npm --prefix frontend run test:watch",
    "test:api": "node scripts/backend.mjs -m pytest -q"
  }
}
